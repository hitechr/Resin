RESIN_ADMIN_TOKEN=change-me-admin-token
# Optional. Sends checked public egress IPs to the configured One IP-compatible provider.
# Requires a nonempty admin token and operator approval of provider terms/privacy.
# RESIN_IP_QUALITY_ENABLED=false
# Separate opt-in for local-midnight/subscription/first-egress inventory checks.
# Enable only after confirming that the configured provider permits automated bulk requests.
# RESIN_IP_QUALITY_AUTO_ENABLED=false
# RESIN_IP_QUALITY_ENDPOINT=https://ip.huzhihui.com/api/ip/health
# Set RESIN_PROXY_TOKEN= to disable proxy authentication.
RESIN_PROXY_TOKEN=change-me-proxy-token
RESIN_PORT=2260
